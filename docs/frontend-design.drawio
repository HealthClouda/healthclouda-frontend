                <mxCell id="d_cookie" value="httpOnly cookies&#xa;access (1h) · refresh · user" style="shape=cylinder3;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="978" width="340" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="d_toast" value="zustand — toast store&#xa;(the only client store today)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="440" y="978" width="340" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="d_session" value="zustand — session store&#xa;role · org · duty  (single source)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#B85450;dashed=1;fontSize=13;verticalAlign=middle;fontColor=#8a2a2a;" parent="1" vertex="1">
                    <mxGeometry x="820" y="978" width="380" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a_leg" value="LEGEND&#xa;--&gt;  flow (built)&#xa;- -&gt;  target / not built&#xa;[blue] client&#xa;[orange] edge / hosting&#xa;[grey] request pipeline&#xa;[green] built in repo today&#xa;[purple] data / store&#xa;[red-dash] NOT BUILT — target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="1250" y="540" width="320" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="a_ref" value="Auth &amp; Session  [ref]&#xa;the guard's cookie contract&#xa;lives on that page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EEFF;strokeColor=#6C8EBF;dashed=1;fontSize=13;fontStyle=2;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1250" y="400" width="320" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="a_note" value="Target shell. Cloudflare sits IN FRONT of Vercel (front door in phase 1; hosting migration is a later, separate decision — see Deployment page). middleware.ts is the ONLY route guard: it reads the httpOnly session cookies, redirects unauthenticated dashboard hits to the correct portal signin (org-scoped when the first path segment is an org slug), and bounces already-signed-in users away from signin pages to their role dashboard. It deliberately never calls the API — it trusts cookie PRESENCE only, and real authorisation is enforced server-side on every request." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;fontColor=#2e5e34;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1120" width="1180" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="a_gap" value="GAP (add before beta): (1) No per-segment error.tsx / loading.tsx — an exception thrown inside any dashboard segment bubbles to the root and blanks the page, with no retry affordance. (2) No shared session store — every dashboard re-parses the user cookie independently, so role / org context can drift between panels on the same screen. (3) middleware duplicates the role-&gt;path map from lib/router.ts by hand; the two can silently diverge." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#B85450;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#8a2a2a;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1250" width="1180" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="ed1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#B85450;fontSize=11;" parent="1" source="c_browser" target="e_cf" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ed2" value="proxied origin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#B85450;fontSize=11;" parent="1" source="e_cf" target="e_vercel" edge="1">
