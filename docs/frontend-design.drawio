                </mxCell>
                <mxCell id="b_api" value="HealthClouda API — Django REST Framework on Railway&#xa;/auth/login/  ·  /auth/login/&lt;org_slug&gt;/  ·  /auth/login/admin/  ·  /auth/refresh/  ·  /auth/me/  ·  /auth/setup-password/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="796" width="850" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="b_ref" value="Backend · Auth / Identity  [ref]&#xa;lockout · throttle · JWT service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EEFF;strokeColor=#6C8EBF;dashed=1;fontSize=13;fontStyle=2;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="930" y="796" width="270" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="d_cookie" value="httpOnly cookies&#xa;access (1h) · refresh · user" style="shape=cylinder3;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="948" width="340" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="d_mem" value="in-memory Map&#xa;login attempt counter&#xa;(per-instance — see GAP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="440" y="948" width="340" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="d_shared" value="Shared throttle counter&#xa;DRF throttling (authoritative)&#xa;+ CF rate-limit (defence in depth)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#B85450;dashed=1;fontSize=13;verticalAlign=middle;fontColor=#8a2a2a;" parent="1" vertex="1">
                    <mxGeometry x="820" y="948" width="380" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="s_leg" value="LEGEND&#xa;--&gt;  flow (built)&#xa;- -&gt;  target / not built&#xa;[blue] client form&#xa;[green] built in repo today&#xa;[purple] data / store&#xa;[red] external / backend&#xa;[blue-dash] [ref] backend subsystem&#xa;[red-dash] NOT BUILT — target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BBBBBB;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="1250" y="420" width="320" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="s_note" value="Three login portals stay strictly distinct: /auth/login/ (patients only), /auth/login/&lt;org_slug&gt;/ (staff + patients), /auth/login/admin/ (superadmin only). A staff member hitting the general portal gets a 400 carrying org_slug + redirect_url — the UI uses that to redirect them to their own org portal automatically rather than showing a dead end. Tokens live ONLY in httpOnly cookies set by the BFF; browser JavaScript never sees an access or refresh token, which is what makes an XSS bug non-fatal for the session." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;fontColor=#2e5e34;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1090" width="1180" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="s_gap" value="GAP (fix before beta): (1) REFRESH ROTATION — /api/auth/refresh does not persist the rotated refresh token the backend returns, so sessions die roughly hourly and users are logged out mid-task. This is the highest-impact auth defect. (2) LOGIN THROTTLE — the attempt counter is an in-process Map: it is per-lambda-instance on Vercel today (already leaky) and would be near-useless on Workers isolates. The authoritative fix is DRF throttling backend-side, with Cloudflare edge rate-limiting as defence in depth. (3) Once proxied by Cloudflare, the throttle key MUST switch from x-forwarded-for to CF-Connecting-IP, or every request will look like one client." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#B85450;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;fontColor=#8a2a2a;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1220" width="1180" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="sd1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#B85450;fontSize=11;" parent="1" source="f_signin" target="g_cf" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sd2" value="filtered" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#B85450;fontSize=11;" parent="1" source="g_cf" target="a_login" edge="1">
