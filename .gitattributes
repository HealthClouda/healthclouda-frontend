# Normalize all text files to LF on commit (prevents CRLF warnings on Windows)
* text=auto eol=lf

# Explicit file types
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.env* text eol=lf

# iCalendar — RFC 5545 REQUIRES CRLF line endings. Normalising these to LF
# produces a file some calendar clients reject on import, silently.
*.ics  text eol=crlf

# Binary — never normalize
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary