# HealthClouda Frontend — Environment Variables
#
# Copy this file to .env.local for local development.
# NEVER commit .env.local — it is already in .gitignore.
# Production values live in the Vercel dashboard under
# Project → Settings → Environment Variables.

# ── API ──────────────────────────────────────────────────────────
# Backend base URL (no trailing slash). Override per Vercel environment.
#   dev:        http://localhost:8000/api/v1
#   preview:    https://api-staging.healthclouda.ng/api/v1
#   production: https://healthclouda-backend-production.up.railway.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── Auth cookies ─────────────────────────────────────────────────
# Domain for httpOnly cookies in production (e.g. .healthclouda.ng).
# Leave unset for localhost — defaults to request host.
# COOKIE_DOMAIN=.healthclouda.ng

# ── Vercel environment mapping ───────────────────────────────────
# Recommended branch → environment mapping in the Vercel dashboard:
#   Production  → main     (live patients + staff)
#   Preview     → staging  (beta / UAT)
#   Development → develop  (feature branches)